DATABASE_URL="host=127.0.0.1 port=5432 dbname=html_hub user=html_hub_app password=REPLACE_ME"
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ENVIRONMENT=development
SMS_MODE=development
WEB_ORIGIN=http://127.0.0.1:5173
CONTENT_ORIGIN=http://127.0.0.1:8011
# 留空时根据默认路由检测局域网 IP；部署域名或代理时设为实际可访问地址。
MCP_PUBLIC_URL=
STORAGE_BACKEND=local
MAX_UPLOAD_MB=20
MAX_EXPANDED_MB=100
MAX_ZIP_FILES=1000
DEFAULT_QUOTA_MB=1024
# S3 模式需预先创建私有 bucket；本地模式无需配置。
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=html-hub
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
NGINX_ACCEL=false
